# Postgres
POSTGRES_USER=pstreview
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pstreview
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
# How many import/export jobs the worker container runs at once. Each is a
# separate OS process, so keep this at or below the container's CPU count.
CELERY_WORKER_CONCURRENCY=2
# How many documents a single import job renders in parallel (PDF rendering,
# OCR). This is independent of CELERY_WORKER_CONCURRENCY above and is the
# main knob for import speed -- raise it on a box with more CPU cores.
RENDER_CONCURRENCY=4
# How many manifest entries (emails, contacts, calendar items) a single
# import job parses in parallel before dedup/rendering. Lighter per-item
# work than rendering, so this can usually run higher.
PARSE_CONCURRENCY=8

# Backend
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
STORAGE_ROOT=/data
BACKEND_CORS_ORIGINS=http://localhost
ENABLE_API_DOCS=false
# Only needed if you configure OIDC login (Admin > System settings) --
# encrypts the OIDC client secret at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# Frontend
VITE_API_BASE_URL=/api
# Host port the frontend is published on. Change this if 80 is already in
# use, or if `docker compose up` reports "port is already allocated" for it
# even though nothing appears to be listening (a known intermittent issue on
# some hosts -- install.sh retries automatically with a fallback port when
# this happens).
FRONTEND_PORT=80
